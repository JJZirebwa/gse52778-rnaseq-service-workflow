nextflow.enable.dsl = 2

params.samplesheet = "${projectDir}/data/samples.csv"
params.outdir = "${projectDir}/results"
params.container_image = 'gse52778-rnaseq-service-workflow:1.0.0'
params.base_container = 'bioconductor/bioconductor_docker:RELEASE_3_20@sha256:5053f59de1c1a79b5a05d820ba722bae62ded0c1042e547189aa0226f111ea7e'
params.git_commit = 'unavailable'

process {
    executor = 'local'
    errorStrategy = 'terminate'
    shell = ['/bin/bash', '-euo', 'pipefail']
}

profiles {
    standard {
        docker.enabled = false
    }

    docker {
        docker.enabled = true
    }
}

timeline {
    enabled = false
}

report {
    enabled = false
}

trace {
    enabled = false
}

dag {
    enabled = false
}
